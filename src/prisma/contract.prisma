// use prisma-8

enum UserRole {
  AGENT
  LEAD
  MANAGER
}

model User {
  id           String   @id @onCreate(cuid(2))
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(AGENT)
  createdAt    DateTime @default(now()) @onCreate(now())
  updatedAt    temporal.UpdatedAt
}